# API de OpenAI (requerida para el agente de ventas)
OPENAI_API_KEY=sk-...

# Redis para historial de sesiones por usuario
REDIS_URL=redis://localhost:6379/0

# Token secreto para verificar el webhook de Meta/WhatsApp
# Podés poner cualquier string; lo mismo tenés que configurar en el panel de Meta
WEBHOOK_VERIFY_TOKEN=un_token_secreto_que_vos_eligas

# Ruta al archivo JSON con la configuración de tiendas
# Copiá tenants.example.json a tenants.json y completá los datos
TENANTS_FILE=tenants.json
